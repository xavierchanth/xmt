<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>OSBundleUsageDescription</key>
	<string>Provides the virtual keyboard that XMT's Keyboard Customization module would use to emit resolved key output.</string>
	<!--
	    Deliberately omitted: IOKitPersonalities.

	    A DriverKit extension is matched and loaded through its personalities.
	    This bundle declares none, so it cannot match any provider, cannot be
	    loaded by the system, and cannot attach to hardware even if it were
	    signed and installed. That is the non-activating property the T-1
	    build-only gate requires; adding personalities is a separate,
	    separately authorized change.
	-->
</dict>
</plist>
