<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    REQUESTED, NOT GRANTED.

    Every key below is a restricted DriverKit entitlement. None of them has
    been requested from, let alone granted by, Apple for this project, and no
    provisioning profile in this environment carries any of them. This file
    records what the design would need; it is not evidence of approval.

    The target that references this file builds with CODE_SIGNING_ALLOWED = NO,
    so these values are never applied to a signature. Signing with them
    requires a Developer ID team, an explicit Apple entitlement grant, and a
    matching provisioning profile — see
    docs/qa/keyboard-driverkit-feasibility.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.family.hid.device</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.hid</key>
	<true/>
</dict>
</plist>
